# --- LLM provider ---
# Options: gemini (default), groq, ollama, auto / fallback
LLM_PROVIDER=gemini
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Self-healing SQL retry loop
ENABLE_SELF_HEALING=true

# --- Environment ---
ENVIRONMENT=local

# --- Database ---
# Local Postgres install — replace YOUR_PASSWORD with your actual postgres password.
APP_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/app_db
ANALYTICS_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/chinook